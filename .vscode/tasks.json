{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "PATH": "C:/msys64/mingw64/bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "Configure Shattered Oath (Debug)",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/cmake.exe",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Shattered Oath (Debug)",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/cmake.exe",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "shattered_oath",
                "--parallel", "4"
            ],
            "dependsOn": "Configure Shattered Oath (Debug)",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
